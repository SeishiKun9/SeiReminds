<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude encrypted credentials and local SQLite data from cloud backups and device transfers. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
