<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce TLS/HTTPS for all app traffic; block accidental cleartext HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
